{
  "$defs": {
    "Allergen": {
      "description": "Allergen tags (Plan C.3).",
      "enum": [
        "peanut",
        "tree_nut",
        "milk",
        "egg",
        "fish",
        "crustacean",
        "mollusc",
        "soy",
        "gluten",
        "sesame",
        "mustard",
        "celery",
        "lupin",
        "sulphites"
      ],
      "title": "Allergen",
      "type": "string"
    },
    "Diet": {
      "description": "Diet tags a profile can carry (Plan C.3).",
      "enum": [
        "vegan",
        "vegetarian",
        "eggetarian",
        "jain",
        "halal",
        "kosher",
        "pescatarian",
        "lactose_free"
      ],
      "title": "Diet",
      "type": "string"
    },
    "HistoryTurn": {
      "additionalProperties": false,
      "properties": {
        "content": {
          "maxLength": 2000,
          "title": "Content",
          "type": "string"
        },
        "role": {
          "enum": [
            "user",
            "assistant"
          ],
          "title": "Role",
          "type": "string"
        },
        "route": {
          "anyOf": [
            {
              "enum": [
                "physical",
                "nutrition",
                "mental",
                "holistic",
                "greeting",
                "meta",
                "off_topic"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Route"
        },
        "ts": {
          "format": "date-time",
          "title": "Ts",
          "type": "string"
        }
      },
      "required": [
        "role",
        "content",
        "ts"
      ],
      "title": "HistoryTurn",
      "type": "object"
    },
    "UserProfile": {
      "additionalProperties": false,
      "properties": {
        "allergen_tags": {
          "items": {
            "$ref": "#/$defs/Allergen"
          },
          "maxItems": 14,
          "title": "Allergen Tags",
          "type": "array"
        },
        "condition_ids": {
          "items": {
            "maxLength": 40,
            "pattern": "^[a-z0-9_]+$",
            "type": "string"
          },
          "maxItems": 30,
          "title": "Condition Ids",
          "type": "array"
        },
        "diet_tags": {
          "items": {
            "$ref": "#/$defs/Diet"
          },
          "maxItems": 8,
          "title": "Diet Tags",
          "type": "array"
        },
        "notes": {
          "maxLength": 1000,
          "title": "Notes",
          "type": "string"
        }
      },
      "required": [
        "condition_ids",
        "allergen_tags",
        "diet_tags",
        "notes"
      ],
      "title": "UserProfile",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "agent": {
      "anyOf": [
        {
          "enum": [
            "physical",
            "nutrition",
            "mental",
            "holistic",
            "greeting",
            "meta",
            "off_topic"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Agent"
    },
    "client_request_id": {
      "format": "uuid",
      "title": "Client Request Id",
      "type": "string"
    },
    "contract_version": {
      "minimum": 1,
      "title": "Contract Version",
      "type": "integer"
    },
    "guest_history": {
      "anyOf": [
        {
          "items": {
            "$ref": "#/$defs/HistoryTurn"
          },
          "maxItems": 6,
          "type": "array"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Guest History"
    },
    "guest_profile": {
      "anyOf": [
        {
          "$ref": "#/$defs/UserProfile"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "message": {
      "maxLength": 2000,
      "minLength": 1,
      "title": "Message",
      "type": "string"
    }
  },
  "required": [
    "message",
    "client_request_id",
    "contract_version"
  ],
  "title": "ChatPayload",
  "type": "object"
}
