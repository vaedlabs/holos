          "default": false,
          "title": "Left Out",
          "type": "boolean"
        },
        "reason": {
          "maxLength": 200,
          "title": "Reason",
          "type": "string"
        },
        "rule_id": {
          "maxLength": 40,
          "title": "Rule Id",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "item",
        "rule_id",
        "attributes",
        "reason"
      ],
