# Database
DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/holos_db
# Integration tests only; a separate database the app user owns
TEST_DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/holos_test

# Sessions and CSRF (Plan C.6). Two different values, at least 32 bytes each:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET=generate-with-secrets.token_urlsafe-48
IP_SALT_SECRET=generate-another-with-secrets.token_urlsafe-48

# Origins: the frontend and this API (production: https://app.<domain>, https://api.<domain>)
APP_ORIGIN=http://localhost:3000
API_ORIGIN=http://localhost:8000

# Client IP: cloudflare (CF-Connecting-IP from Cloudflare's ranges only) or none (the peer)
TRUSTED_PROXY=none

# Cloudflare Turnstile secrets. Dev and tests use Cloudflare's always-pass test key;
# production uses the real keys of the managed and the interactive widget (Phase 7)
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
TURNSTILE_INTERACTIVE_SECRET_KEY=1x0000000000000000000000000000000AA

# Rate limits (requests per window)
RATE_LIMIT_DEFAULT=200
RATE_LIMIT_AGENT=60
RATE_LIMIT_AUTH=30
RATE_LIMIT_WINDOW=60

# OpenAI
OPENAI_API_KEY=your-openai-api-key-here

# Google Gemini
GOOGLE_GEMINI_API_KEY=your-gemini-api-key-here

# Tavily (web search)
TAVILY_API_KEY=your-tavily-api-key-here

# Application
ENVIRONMENT=development
LOG_LEVEL=INFO
