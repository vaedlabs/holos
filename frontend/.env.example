# Frontend settings (Plan B.3). Copy to .env.local; never commit real values.

# The backend's address (API_ORIGIN on the backend). Use the same host as the app: the
# session cookie is SameSite=Lax, so an app on localhost can't use one set by 127.0.0.1
NEXT_PUBLIC_API_URL=http://localhost:8000

# Cloudflare Turnstile site keys (C.6): the managed widget, and the interactive one the
# server asks for when a network needs a closer check (C.12). These are Cloudflare's test
# keys (always pass); they work with the backend's test secrets (1x0000…AA, Part D).
NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
NEXT_PUBLIC_TURNSTILE_INTERACTIVE_SITE_KEY=1x00000000000000000000AA
